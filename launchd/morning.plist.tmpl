<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0"><dict>
  <key>Label</key><string>com.career-ops.morning</string>
  <key>ProgramArguments</key><array><string>__NODE__</string><string>__DIR__/morning.mjs</string></array>
  <key>WorkingDirectory</key><string>__DIR__</string>
  <key>EnvironmentVariables</key><dict><key>PATH</key><string>__PATH__</string></dict>
  <key>RunAtLoad</key><true/>
  <key>StartCalendarInterval</key><dict><key>Hour</key><integer>8</integer><key>Minute</key><integer>0</integer></dict>
  <key>StandardOutPath</key><string>__DIR__/logs/morning.log</string>
  <key>StandardErrorPath</key><string>__DIR__/logs/morning.log</string>
</dict></plist>
